# Copy to .env and fill in the secrets:  cp .env.example .env
# .env is git-ignored; never commit real keys or passwords.

# --- Neo4j (docker-compose.yml reads NEO4J_PASSWORD from here) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me            # e.g. generate with: openssl rand -hex 12

# --- SEC EDGAR (only needed to rebuild the corpus): SEC requires "Name email" as User-Agent ---
SEC_USER_AGENT="Your Name your.email@example.com"

# --- LLM backend selection: groq | claude_cli | antigravity_cli ---
LLM_BACKEND=groq

# --- Backend A: Groq (free tier: 30 req/min, 8K tokens/min, 200K tokens/day) ---
GROQ_API_KEY=your-groq-api-key      # https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low           # low | medium | high (reasoning tokens count against the budget)
GROQ_RPM=30
GROQ_TPM=8000                       # tokens per minute (free tier)
GROQ_DAILY_TOKENS=200000

# --- Backend B: Claude via `claude -p` (WORKAROUND, uses the Claude Pro plan) ---
CLAUDE_MODEL=sonnet                 # sonnet (default: quality close to gpt-oss-120b) | opus | haiku
CLAUDE_RPM=10
CLAUDE_DAILY_TOKENS=2000000         # self-imposed cap; Pro limits are per 5-hour window

# --- Backend C: Google Antigravity via `agy` (WORKAROUND, separate 5-hour + weekly quota) ---
AGY_MODEL=gemini-4-hydrogen-medium  # see `agy models`; low | medium | high | xhigh = thinking effort
AGY_RPM=10
AGY_DAILY_TOKENS=2000000            # self-imposed cap; check real usage with `agy -p /usage`
